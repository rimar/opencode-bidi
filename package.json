  "type": "module",
  "license": "MIT",
  "author": "Yuval Rimar",
  "packageManager": "pnpm@10.11.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rimar/opencode-bidi.git"
  },
  "homepage": "https://github.com/rimar/opencode-bidi#readme",
  "bugs": {
    "url": "https://github.com/rimar/opencode-bidi/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "firefox",
    "webdriver-bidi",
    "bidi",
    "browser-automation",
    "ai-agent"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.3.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
